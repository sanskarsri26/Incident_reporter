# Every variable below is optional. With none set, the app runs entirely on
# an in-memory repository and deterministic mock LLM/embedding providers --
# no external account is required for local development or CI.

# Gemini Developer API (server-side only -- never prefix with NEXT_PUBLIC_).
# Unset: falls back to the deterministic mock LLM/embedding providers.
GEMINI_API_KEY=
# Confirmed working against the real API as of 2026-08-22. Google
# deprecates model names over time -- if this starts 404ing, check
# https://ai.google.dev/gemini-api/docs/models for the current name.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Supabase Postgres + pgvector (server-side only). Unset: falls back to the
# in-memory repository (does not persist across process restarts).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Only needed if the frontend talks to Supabase directly via RLS policies;
# this project's API routes always use the service role key server-side.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis REST API, used for rate limiting. Unset: falls back to an
# in-memory token-bucket limiter (per server instance, not shared across
# serverless invocations -- fine for a demo, not for real multi-instance
# production traffic).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
